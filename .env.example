# Roman AI OS Control Panel — example environment file.
# Copy to `.env` for local development. NEVER commit a real `.env`.
#
# IMPORTANT (security): everything prefixed with VITE_ is inlined into the
# client bundle and is therefore PUBLIC. Never put API keys, tokens, GBrain
# bearer credentials or any secret here. Secrets belong in the future thin
# backend/gateway, not in this frontend.

# Which data source the adapters use.
#   mock    — bundled demo fixtures (default, nothing real is contacted)
#   gateway — the future thin backend/gateway (not implemented yet)
VITE_DATA_SOURCE=mock

# Base URL of the future Roman AI OS gateway. The gateway holds the secrets and
# talks to GBrain / GitHub / Drive / Hermes on the frontend's behalf.
# Leave empty while VITE_DATA_SOURCE=mock.
VITE_GATEWAY_URL=
