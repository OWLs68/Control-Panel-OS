# Roma gateway — copy to .env on the Mac. Never commit .env.
# The gateway listens on 127.0.0.1 only; Tailscale Serve is the only way in.
ROMA_GATEWAY_PORT=8787

# Tailscale logins allowed through, comma-separated. Empty = nobody (fail closed).
# Serve adds the Tailscale-User-Login header; the value is your Tailscale login.
ROMA_ALLOWED_LOGINS=

# Exact origins the PWA is served from. Never "*".
ROMA_ALLOWED_ORIGINS=https://owls68.github.io

# GBrain MCP over HTTP, as the Mac sees it (local address, not a public one).
GBRAIN_MCP_URL=
# streamable (default) or sse — whichever the installed GBrain serves.
GBRAIN_MCP_TRANSPORT=streamable
# A DEDICATED read-only client token for this gateway. Not Hermes', not Claude's.
GBRAIN_TOKEN=
# How many recent facts one snapshot carries (GBrain caps recall at 100).
GBRAIN_RECALL_LIMIT=50

# ── Crow through Hermes ───────────────────────────────────────────────
# Leave HERMES_TOKEN_FILE empty to keep POST /api/v1/crow at 501; memory still works.
# Hermes' JSON-RPC WebSocket, loopback only. The phone never learns this address.
HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
# The Hermes session token lives in a file with mode 600. ONLY the path goes here — never the value.
HERMES_TOKEN_FILE=~/.hermes/roma-crow-token
# Where the gateway keeps Hermes' stored_session_id between restarts. Outside the repo; created 0600.
HERMES_SESSION_STATE_FILE=~/.roma-gateway/hermes-session.json
# The socket must open and gateway.ready must arrive within this — short, so a sleeping Mac fails fast.
HERMES_CONNECT_TIMEOUT_MS=5000
# prompt.submit → message.complete may take this long: the agent thinks and calls tools.
HERMES_TURN_TIMEOUT_MS=120000
