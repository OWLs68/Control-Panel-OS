{
  "name": "roma-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Roma gateway — the one door from the phone to GBrain: read-only, behind Tailscale, on the Mac.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "lint": "eslint --config ../../eslint.config.js .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
