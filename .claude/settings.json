{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git merge *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-merge-sync.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
