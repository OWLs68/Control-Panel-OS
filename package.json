{
  "name": "roma-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server/roma-gateway"
  ],
  "type": "module",
  "description": "Crow OS MP — змінний інтерфейс Crow AI OS (PWA)",
  "scripts": {
    "build": "node build.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node build.js --tests && node --test \".tmp/tests/*.test.js\"",
    "e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && node scripts/check-gateway-boundary.mjs && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
